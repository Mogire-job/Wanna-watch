# Local development only. Use strong credentials outside your machine.
WANNA_WATCH_DB_NAME=wannawatch
WANNA_WATCH_DB_USER=wannawatch
WANNA_WATCH_DB_PASSWORD=wannawatch
WANNA_WATCH_DB_URL=jdbc:postgresql://localhost:5433/wannawatch
WANNA_WATCH_DB_HOST_PORT=5433
WANNA_WATCH_DEFAULT_COUNTRY=US

# TMDB API Read Access Token (keep this private; never commit your real token).
WANNA_WATCH_TMDB_API_READ_ACCESS_TOKEN=
WANNA_WATCH_SYNC_TOKEN=
WANNA_WATCH_TMDB_SYNC_PAGES=1

# SMTP is required to send verification emails (example: SMTP submission on port 587).
WANNA_WATCH_SMTP_HOST=localhost
WANNA_WATCH_SMTP_PORT=1025
WANNA_WATCH_SMTP_USERNAME=
WANNA_WATCH_SMTP_PASSWORD=
WANNA_WATCH_SMTP_AUTH=false
WANNA_WATCH_SMTP_STARTTLS=false
WANNA_WATCH_MAIL_FROM=no-reply@wannawatch.local

# Optional Google OAuth credentials from a Google Cloud OAuth web client.
WANNA_WATCH_GOOGLE_CLIENT_ID=
WANNA_WATCH_GOOGLE_CLIENT_SECRET=
WANNA_WATCH_GOOGLE_SIGN_IN_ENABLED=false
WANNA_WATCH_FRONTEND_URL=http://localhost:5174
